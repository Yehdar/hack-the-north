# ---------------------------------------------------------------------------
# Copy to .env.local. Never commit .env.local.
# Every key here is server-side only — nothing is NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Gemini — the free one, and what the public deployment runs on.
#
# Google's free tier needs no credit card and does not expire: 1,500 requests
# a day, which is roughly a hundred full deliberations. Get a key in about a
# minute at https://aistudio.google.com/apikey.
#
# Every call that is refused, throttled or comes back empty falls through to
# the demo provider, so running out of quota costs realism and never an error.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# The 2.5 line is retired for keys issued after roughly mid-2026 and answers
# 404 to them, so these are pinned to a model a new key can actually reach.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.6-flash
# Stop calling Google after this many requests in a day. Under the real 1,500
# on purpose, so a burst near the ceiling still has somewhere to go.
# GEMINI_DAILY_BUDGET=1200

# OpenAI — agent reasoning. Absent => the mock provider is used automatically,
# so the whole app still builds and runs with no key at all.
OPENAI_API_KEY=
# Deep tier: seat reasoning, cross-examination, rebuttal.
OPENAI_MODEL=gpt-5.6-sol
# Fast tier: the Moderator, which runs on every founder speech turn.
OPENAI_FAST_MODEL=gpt-5.6-luna

# ElevenLabs — STT (Scribe) and TTS for the IC meeting. Absent => voice falls
# back to the browser Web Speech API, then to text-only chat.
# A key scoped to text_to_speech only is fine — the app reports that it could
# not verify voice ids and carries on speaking.
ELEVENLABS_API_KEY=

# Anthropic — alternative provider. Used when no OpenAI key is present.
# Gemini is tried after both, so a paid key you set on purpose wins.
# NOTE: a Claude Pro/Max subscription does NOT include API access; this is a
# separate, separately-billed console.anthropic.com key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# How hard reasoning models think before answering: low | medium | high.
# Low keeps a live deliberation quick; raise it for rehearsal quality.
# LLM_EFFORT=low

# After adding a key, restart and open /api/system/check: one tiny call per
# tier, so a bad key or a model name that does not exist shows up now rather
# than as a silent committee on stage.

# Force a provider. demo = realistic fake output, no key, no network.
# LLM_PROVIDER=gemini | openai | anthropic | demo | mock

# Record every model exchange to fixtures/llm.json while running for real.
# Do one full run with this set before the demo.
# RECORD_FIXTURES=1

# Replay those fixtures instead of calling any API. Works with the network off.
# This is the stage insurance policy and it wins over every other setting.
# DEMO_MODE=1
